# Pocket Room 서버 환경변수 예시 파일
# ──────────────────────────────────────────────────────────────
# 사용법: 이 파일을 복사해 `.env` 로 만들고, 아래 값들을 직접 채우세요.
#         (.env 는 .gitignore 에 등록돼 있어 절대 공유되지 않습니다)
#
# ⚠️ 실제 비밀값(DB 비밀번호, JWT 시크릿)은 이 파일이 아닌 .env 에만 넣고,
#    코드/문서/대화 어디에도 평문으로 남기지 마세요. (CLAUDE.md 보안 규칙)

# Render PostgreSQL 연결 문자열 (External Database URL 복사 → 붙여넣기)
# 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# JWT 시크릿 (각각 길고 무작위한 문자열로 직접 생성)
# 생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# (선택) 토큰 만료 시간 — 비워두면 코드 기본값(access 15m / refresh 14d) 사용
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=14d

# 서버 포트 (Render 는 PORT 를 자동 주입하므로 로컬에서만 의미 있음)
PORT=3000
